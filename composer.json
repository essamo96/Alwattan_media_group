{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=7.2.5",
        "astrotomic/laravel-translatable": "^11.8",
        "bumbummen99/shoppingcart": "^2.9",
        "fideloper/proxy": "^4.0",
        "intervention/image": "^2.4",
        "laravel/framework": "7.*",
        "laravel/helpers": "^1.2",
        "laravel/tinker": "2.*",
        "laravel/ui": "^2.0",
        "mcamara/laravel-localization": "^1.5",
        "phpmailer/phpmailer": "^6.0",
        "spatie/laravel-cookie-consent": "^2.12",
        "spatie/laravel-permission": "3.*",
        "unisharp/laravel-filemanager": "1.*",
        "yajra/laravel-datatables-oracle": "9.*"
    },
    "require-dev": {
        "fzaninotto/faker": "~1.4",
        "mockery/mockery": "0.9.*",
        "phpunit/phpunit": "~7.0",
        "filp/whoops": "~2.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
       
    }
}
